{
  "name": "railway-operating-plan-creator",
  "version": "0.1.0",
  "private": true,
  "description": "Build a rail operating plan, play it step by step, and share it.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.player.json",
    "dev": "vite",
    "predev": "npm run build:player",
    "build": "npm run typecheck && vite build",
    "prebuild": "npm run build:player",
    "build:player": "vite build -c vite.player.config.ts",
    "check-schema": "node scripts/check-schema.mjs",
    "preview": "vite preview",
    "check": "npm test && npm run typecheck && npm run check-schema && npm run test:e2e && npm run build && npm run test:e2e:production",
    "test:e2e:production": "playwright test --config playwright.production.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "ajv": "8.20.0",
    "happy-dom": "21.0.4",
    "typescript": "5.6.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "pptxgenjs": "4.0.1"
  },
  "overrides": {
    "image-size": "2.0.4"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
