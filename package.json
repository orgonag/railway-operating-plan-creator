{
  "name": "railway-operating-plan-creator",
  "version": "0.1.0",
  "private": true,
  "description": "Build a rail operating plan, play it step by step, and share it.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "dev": "vite",
    "predev": "npm run build:player",
    "build": "npm run typecheck && vite build",
    "prebuild": "npm run build:player",
    "build:player": "vite build -c vite.player.config.ts",
    "check-schema": "node scripts/check-schema.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "ajv": "8.17.1",
    "happy-dom": "15.11.0",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
