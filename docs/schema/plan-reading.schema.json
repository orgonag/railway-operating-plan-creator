{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/orgonag/railway-operating-plan-creator/docs/schema/plan-reading.schema.json",
  "title": "PlanReading",
  "description": "What the AI sends after reading an operating plan document. Railway terms only, no coordinates. Code turns this into the canvas plan. Version 0.3.",
  "type": "object",
  "required": [
    "schemaVersion",
    "title",
    "arrival",
    "tracks",
    "switches",
    "facilities",
    "consist",
    "work",
    "departure"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0.3"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "arrival": {
      "description": "One plan covers one arrival direction. A different direction is a different plan.",
      "type": "object",
      "required": [
        "direction",
        "enters",
        "on",
        "locos",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "direction": {
          "$ref": "#/$defs/direction"
        },
        "enters": {
          "description": "Which side of the drawing the arriving train comes in from. Switch sides (left, right) are relative to the arriving train.",
          "enum": [
            "left",
            "right"
          ]
        },
        "on": {
          "description": "The main track the train arrives on.",
          "$ref": "#/$defs/id"
        },
        "locos": {
          "description": "Where the power is in the arriving train, relative to its direction of travel.",
          "enum": [
            "head",
            "rear"
          ]
        },
        "text": {
          "type": "string"
        }
      }
    },
    "carLength": {
      "description": "Default car length. The allowance is added on top and always shown, so 60 ft at 10% plans as 66 ft per car.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ft": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 60
        },
        "allowancePct": {
          "type": "number",
          "minimum": 0,
          "default": 10
        }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "role": {
            "enum": [
              "main",
              "siding",
              "spur",
              "yard",
              "lead"
            ]
          },
          "name": {
            "type": "string"
          },
          "lengthFt": {
            "description": "Usable length. Leave out if the document doesn't say; the editor will ask.",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "end": {
            "description": "What is at the far end of the track, away from the switch it leaves from. Main tracks continue.",
            "enum": [
              "buffer_stop",
              "continues",
              "rejoins"
            ]
          }
        }
      }
    },
    "switches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "on",
          "to",
          "side",
          "approach"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "on": {
            "description": "The track the switch sits on.",
            "$ref": "#/$defs/id"
          },
          "to": {
            "description": "The track the diverging route leads to.",
            "$ref": "#/$defs/id"
          },
          "side": {
            "description": "Which side the diverging route leaves on, as seen by the arriving train.",
            "enum": [
              "left",
              "right"
            ]
          },
          "approach": {
            "description": "Facing or trailing point for the arriving train.",
            "enum": [
              "facing",
              "trailing"
            ]
          },
          "order": {
            "description": "1 for the first switch the arriving train reaches on this track, 2 for the next, and so on.",
            "type": "integer",
            "minimum": 1
          },
          "distanceFt": {
            "description": "Distance from the previous switch on the same track. Leave out for the first switch: layout makes the approach long enough for the arriving train.",
            "type": "number",
            "minimum": 0
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "facilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "track"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "unloading_racks",
              "loading_racks",
              "transload",
              "warehouse",
              "other"
            ]
          },
          "track": {
            "$ref": "#/$defs/id"
          },
          "lengthFt": {
            "description": "Length of track alongside the facility.",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "startFt": {
            "description": "Where the facility starts, measured from the switch end of its track. Leave out to place it at the far end.",
            "type": "number",
            "minimum": 0
          },
          "spots": {
            "description": "Number of car spots, if the document shows them.",
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "consist": {
      "type": "object",
      "required": [
        "locos",
        "cuts"
      ],
      "additionalProperties": false,
      "properties": {
        "locos": {
          "type": "object",
          "required": [
            "count"
          ],
          "additionalProperties": false,
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "lengthFt": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Defaults to 74 ft (typical modern six-axle road unit). The car allowance applies on top, so it plans as about 81 ft."
            },
            "type": {
              "enum": [
                "six_axle",
                "four_axle",
                "switcher"
              ]
            }
          }
        },
        "cuts": {
          "description": "Groups of cars in the arriving train, listed from the head end back.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "cars",
              "state"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "cars": {
                "type": "integer",
                "minimum": 1
              },
              "state": {
                "enum": [
                  "loaded",
                  "empty"
                ]
              },
              "carType": {
                "$ref": "#/$defs/carType"
              },
              "carLengthFt": {
                "description": "Overrides the default car length for this cut.",
                "type": "number",
                "exclusiveMinimum": 0
              },
              "for": {
                "description": "Facility these cars are going to, if any.",
                "$ref": "#/$defs/id"
              },
              "list": {
                "description": "Individual cars in this cut, in order from the head end (or from the switch end of the track for cars on site). If present, its length should match cars.",
                "type": "array",
                "items": {
                  "$ref": "#/$defs/car"
                }
              }
            }
          }
        },
        "onSite": {
          "description": "Cars already sitting on customer or other tracks before the train arrives, such as empties waiting to be pulled.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "cars",
              "state",
              "at"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "cars": {
                "type": "integer",
                "minimum": 1
              },
              "state": {
                "enum": [
                  "loaded",
                  "empty"
                ]
              },
              "carType": {
                "$ref": "#/$defs/carType"
              },
              "carLengthFt": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "at": {
                "description": "Facility or track id.",
                "$ref": "#/$defs/id"
              },
              "list": {
                "description": "Individual cars in this cut, in order from the head end (or from the switch end of the track for cars on site). If present, its length should match cars.",
                "type": "array",
                "items": {
                  "$ref": "#/$defs/car"
                }
              },
              "spot": {
                "description": "Spot of the first car, if at a facility.",
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "work": {
      "description": "Spotting and yard work, in order, one action per step. Customer steps and plain note slides can appear anywhere. Any number of steps.",
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/railroadStep"
          },
          {
            "$ref": "#/$defs/customerStep"
          },
          {
            "$ref": "#/$defs/noteStep"
          }
        ]
      }
    },
    "departure": {
      "type": "object",
      "required": [
        "direction",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "direction": {
          "$ref": "#/$defs/direction"
        },
        "cars": {
          "description": "Cuts that leave with the train.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "text": {
          "type": "string"
        }
      }
    },
    "questions": {
      "description": "Import drafts only. One question for every assumption the AI made that it did not read directly from the document. Removed once answered.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "about",
          "ask",
          "basis"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "about": {
            "description": "Field path, collection.id.field, e.g. tracks.SPUR1.lengthFt.",
            "type": "string"
          },
          "ask": {
            "description": "The question in plain words.",
            "type": "string"
          },
          "guess": {
            "description": "The AI's best guess, pre-filled for the person to accept or change."
          },
          "options": {
            "description": "Choices, when the answer is one of a few values.",
            "type": "array",
            "items": {}
          },
          "basis": {
            "description": "What in the document led to the guess.",
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "description": "Anything in the document that didn't fit the fields above.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "direction": {
      "enum": [
        "eastbound",
        "westbound",
        "northbound",
        "southbound"
      ]
    },
    "ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "railroadStep": {
      "type": "object",
      "required": [
        "actor",
        "do",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "actor": {
          "const": "railroad"
        },
        "do": {
          "description": "shove: push cars ahead of the power. pull: draw cars behind the power. cut_off: uncouple the power and leave cars. couple: couple to cars. run_light: move the power alone. runaround: get the power to the other end of its cars. set_out: leave cars on a track. pick_up: collect cars from a track. stop: stop and hold; needs a callout saying why.",
          "enum": [
            "shove",
            "pull",
            "cut_off",
            "couple",
            "run_light",
            "runaround",
            "set_out",
            "pick_up",
            "stop"
          ]
        },
        "cars": {
          "$ref": "#/$defs/ids",
          "description": "Cut ids or individual car ids."
        },
        "to": {
          "description": "Facility or track id the move ends at, or the reserved value \"offstage\" when the power (alone or with cars) leaves the drawing for other work.",
          "$ref": "#/$defs/id"
        },
        "via": {
          "description": "Switches passed through, in order, if the document says.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "text": {
          "type": "string"
        },
        "callout": {
          "$ref": "#/$defs/callout"
        },
        "spot": {
          "description": "Numbered spot at the facility for the first car moved.",
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "do": {
                "const": "stop"
              }
            }
          },
          "then": {
            "required": [
              "callout"
            ]
          }
        }
      ]
    },
    "customerStep": {
      "type": "object",
      "required": [
        "actor",
        "do",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "actor": {
          "const": "customer"
        },
        "do": {
          "enum": [
            "load",
            "unload",
            "move_cars"
          ]
        },
        "cars": {
          "$ref": "#/$defs/ids"
        },
        "to": {
          "description": "For move_cars: the facility or track the customer moves cars to.",
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string"
        },
        "callout": {
          "$ref": "#/$defs/callout"
        },
        "spot": {
          "description": "Numbered spot, for move_cars.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "callout": {
      "description": "A note pinned to a feature during this step, e.g. why the train stops.",
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "at": {
          "description": "Switch, track or facility id to pin the note to.",
          "$ref": "#/$defs/id"
        }
      }
    },
    "noteStep": {
      "type": "object",
      "required": [
        "do",
        "text"
      ],
      "additionalProperties": false,
      "description": "A plain slide: nothing moves, just a caption and an optional callout.",
      "properties": {
        "actor": {
          "enum": [
            "railroad",
            "customer"
          ]
        },
        "do": {
          "const": "note"
        },
        "text": {
          "type": "string"
        },
        "callout": {
          "$ref": "#/$defs/callout"
        }
      }
    },
    "carType": {
      "description": "Side-view silhouette and default length. generic is a 60 ft car.",
      "enum": [
        "generic",
        "boxcar_50",
        "boxcar_60",
        "covered_hopper_small",
        "covered_hopper_large",
        "covered_hopper_plastics",
        "open_hopper",
        "gondola",
        "tank_general",
        "tank_pressure",
        "flat_bulkhead",
        "flat_centerbeam",
        "flat_89",
        "autorack",
        "well_car",
        "reefer"
      ]
    },
    "car": {
      "description": "One car, when specific cars matter.",
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "$ref": "#/$defs/carType"
        },
        "lengthFt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "state": {
          "enum": [
            "loaded",
            "empty"
          ]
        },
        "mark": {
          "description": "Reporting mark, e.g. ABCX.",
          "type": "string"
        },
        "number": {
          "description": "Car number, e.g. 1234.",
          "type": "string"
        },
        "spot": {
          "description": "Numbered spot at a facility.",
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
