{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/orgonag/railway-operating-plan-creator/docs/schema/plan-reading.schema.json",
  "title": "PlanReading",
  "description": "What the AI sends after reading an operating plan document. Railway terms only, no coordinates. Code turns this into the canvas plan. Version 1.",
  "type": "object",
  "required": [
    "schemaVersion",
    "title",
    "arrival",
    "tracks",
    "switches",
    "facilities",
    "consist",
    "work",
    "departure"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "arrival": {
      "description": "One plan covers one arrival direction. A different direction is a different plan.",
      "type": "object",
      "required": [
        "direction",
        "enters",
        "on",
        "locos",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "direction": {
          "$ref": "#/$defs/direction"
        },
        "enters": {
          "description": "Which side of the drawing the arriving train comes in from. Switch sides (left, right) are relative to the arriving train.",
          "enum": [
            "left",
            "right"
          ]
        },
        "on": {
          "description": "The main track the train arrives on.",
          "$ref": "#/$defs/id"
        },
        "locos": {
          "description": "Where the power is in the arriving train, relative to its direction of travel.",
          "enum": [
            "head",
            "rear"
          ]
        },
        "stop": {
          "description": "Where the arriving train stands on the main before work begins. Leave out to start with the head 100 ft short of the first switch.",
          "$ref": "#/$defs/stop"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "carLength": {
      "description": "General planning length for every car, whatever its type. Drawn and counted at this length. The engine applies a slack check of at least allowancePct (10%) only when deciding fit notes.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ft": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 60
        },
        "allowancePct": {
          "type": "number",
          "minimum": 10,
          "default": 10,
          "description": "Slack check used inside the engine for fit notes only. Not added to the drawing. Never below 10."
        }
      }
    },
    "locoLength": {
      "description": "General planning length for every loco, whatever its type.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ft": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 80
        }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "role": {
            "enum": [
              "main",
              "siding",
              "spur",
              "yard",
              "lead"
            ]
          },
          "name": {
            "type": "string"
          },
          "lengthFt": {
            "description": "Usable length. Leave out if the document doesn't say; the editor will ask.",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "end": {
            "description": "What is at the far end of the track, away from the switch it leaves from. Main tracks continue.",
            "enum": [
              "buffer_stop",
              "continues",
              "rejoins"
            ]
          }
        }
      }
    },
    "switches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "on",
          "to",
          "side",
          "approach"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "on": {
            "description": "The track the switch sits on.",
            "$ref": "#/$defs/id"
          },
          "to": {
            "description": "The track the diverging route leads to.",
            "$ref": "#/$defs/id"
          },
          "side": {
            "description": "Which side the diverging route leaves on, as seen by the arriving train.",
            "enum": [
              "left",
              "right"
            ]
          },
          "approach": {
            "description": "Facing or trailing point for the arriving train.",
            "enum": [
              "facing",
              "trailing"
            ]
          },
          "order": {
            "description": "1 for the first switch the arriving train reaches on this track, 2 for the next, and so on.",
            "type": "integer",
            "minimum": 1
          },
          "distanceFt": {
            "description": "Distance from the previous switch on the same track. Leave out for the first switch: layout makes the approach long enough for the arriving train.",
            "type": "number",
            "minimum": 0
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "facilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "track"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "unloading_racks",
              "loading_racks",
              "transload",
              "warehouse",
              "other"
            ]
          },
          "track": {
            "$ref": "#/$defs/id"
          },
          "lengthFt": {
            "description": "Length of track alongside the facility.",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "startFt": {
            "description": "Where the facility starts, measured from the switch end of its track. Leave out to place it at the far end.",
            "type": "number",
            "minimum": 0
          },
          "spots": {
            "description": "Number of car spots, if the document shows them.",
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "consist": {
      "type": "object",
      "required": [
        "locos",
        "cuts"
      ],
      "additionalProperties": false,
      "properties": {
        "locos": {
          "type": "object",
          "required": [
            "count"
          ],
          "additionalProperties": false,
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "lengthFt": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Overrides the general loco length for these locos. The slack factor still applies."
            },
            "type": {
              "$ref": "#/$defs/locoType"
            },
            "list": {
              "description": "Individual locos, in order from the head end. If present, its length should match count.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/loco"
              }
            }
          }
        },
        "cuts": {
          "description": "Groups of cars in the arriving train, listed from the head end back.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "cars",
              "state"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "cars": {
                "type": "integer",
                "minimum": 1
              },
              "state": {
                "enum": [
                  "loaded",
                  "empty"
                ]
              },
              "carType": {
                "$ref": "#/$defs/carType"
              },
              "carLengthFt": {
                "description": "Overrides the default car length for this cut.",
                "type": "number",
                "exclusiveMinimum": 0
              },
              "for": {
                "description": "Facility these cars are going to, if any.",
                "$ref": "#/$defs/id"
              },
              "list": {
                "description": "Individual cars in this cut, in order from the head end (or from the switch end of the track for cars on site). If present, its length should match cars.",
                "type": "array",
                "items": {
                  "$ref": "#/$defs/car"
                }
              }
            }
          }
        },
        "onSite": {
          "description": "Cars already sitting on customer or other tracks before the train arrives, such as empties waiting to be pulled.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "cars",
              "state",
              "at"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "cars": {
                "type": "integer",
                "minimum": 1
              },
              "state": {
                "enum": [
                  "loaded",
                  "empty"
                ]
              },
              "carType": {
                "$ref": "#/$defs/carType"
              },
              "carLengthFt": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "at": {
                "description": "Facility or track id.",
                "$ref": "#/$defs/id"
              },
              "list": {
                "description": "Individual cars in this cut, in order from the head end (or from the switch end of the track for cars on site). If present, its length should match cars.",
                "type": "array",
                "items": {
                  "$ref": "#/$defs/car"
                }
              },
              "spot": {
                "description": "Spot of the first car, if at a facility.",
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "work": {
      "description": "Spotting and yard work, in order, one action per step. Customer steps and plain note slides can appear anywhere. Any number of steps.",
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/railroadStep"
          },
          {
            "$ref": "#/$defs/customerStep"
          },
          {
            "$ref": "#/$defs/noteStep"
          }
        ]
      }
    },
    "departure": {
      "type": "object",
      "required": [
        "direction",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "direction": {
          "$ref": "#/$defs/direction"
        },
        "cars": {
          "description": "Cuts that leave with the train.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "text": {
          "type": "string"
        }
      }
    },
    "questions": {
      "description": "Import drafts only. One question for every assumption the AI made that it did not read directly from the document. Removed once answered.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "about",
          "ask",
          "basis"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "about": {
            "description": "Field path, collection.id.field, e.g. tracks.SPUR1.lengthFt.",
            "type": "string"
          },
          "ask": {
            "description": "The question in plain words.",
            "type": "string"
          },
          "guess": {
            "description": "The AI's best guess, pre-filled for the person to accept or change."
          },
          "options": {
            "description": "Choices, when the answer is one of a few values.",
            "type": "array",
            "items": {}
          },
          "basis": {
            "description": "What in the document led to the guess.",
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "description": "Where each field came from. Keys are field paths (collection.id.field). The engine ignores this; the editor shows it.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "read",
              "assumed",
              "unknown",
              "confirmed"
            ]
          },
          "source": {
            "description": "For read: where in the source, e.g. page 1, label 'Track 2'.",
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "description": "Anything in the document that didn't fit the fields above.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "direction": {
      "enum": [
        "eastbound",
        "westbound",
        "northbound",
        "southbound"
      ]
    },
    "ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "railroadStep": {
      "type": "object",
      "required": [
        "id",
        "actor",
        "do",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Permanent step id. Notes and share links point at it.",
          "$ref": "#/$defs/id"
        },
        "actor": {
          "const": "railroad"
        },
        "do": {
          "description": "shove, pull, run_light: moves. uncouple: split between two named pieces of equipment; cut_off: uncouple the power from its cars. couple: couple to cars. stop: stop and hold, needs a callout. runaround, set_out, pick_up: shortcuts, expanded into single steps before saving.",
          "enum": [
            "shove",
            "pull",
            "uncouple",
            "cut_off",
            "couple",
            "run_light",
            "runaround",
            "set_out",
            "pick_up",
            "stop"
          ]
        },
        "cars": {
          "$ref": "#/$defs/ids",
          "description": "Car, loco or group ids."
        },
        "to": {
          "description": "Facility or track id the move ends at, or the reserved value \"offstage\" when the power (alone or with cars) leaves the drawing for other work.",
          "$ref": "#/$defs/id"
        },
        "via": {
          "description": "Switches passed through, in order, if the document says.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "text": {
          "type": "string"
        },
        "callout": {
          "$ref": "#/$defs/callout"
        },
        "spot": {
          "description": "Numbered spot at the facility: the leading unit's front goes to this spot's far edge.",
          "type": "integer",
          "minimum": 1
        },
        "stop": {
          "$ref": "#/$defs/stop"
        },
        "between": {
          "description": "For uncouple: the two adjacent pieces of equipment to split.",
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "do": {
                "const": "stop"
              }
            }
          },
          "then": {
            "required": [
              "callout"
            ]
          }
        }
      ]
    },
    "customerStep": {
      "type": "object",
      "required": [
        "id",
        "actor",
        "do",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "actor": {
          "const": "customer"
        },
        "do": {
          "enum": [
            "load",
            "unload",
            "move_cars"
          ]
        },
        "cars": {
          "$ref": "#/$defs/ids"
        },
        "to": {
          "description": "For move_cars: the facility or track the customer moves cars to.",
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string"
        },
        "callout": {
          "$ref": "#/$defs/callout"
        },
        "spot": {
          "description": "Numbered spot, for move_cars: the leading unit's front goes to this spot's far edge.",
          "type": "integer",
          "minimum": 1
        },
        "stop": {
          "$ref": "#/$defs/stop"
        }
      }
    },
    "callout": {
      "description": "A note pinned to a feature during this step, e.g. why the train stops.",
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "at": {
          "description": "Switch, track or facility id to pin the note to.",
          "$ref": "#/$defs/id"
        }
      }
    },
    "noteStep": {
      "type": "object",
      "required": [
        "id",
        "do",
        "text"
      ],
      "additionalProperties": false,
      "description": "A plain slide: nothing moves, just a caption and an optional callout.",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "actor": {
          "enum": [
            "railroad",
            "customer"
          ]
        },
        "do": {
          "const": "note"
        },
        "text": {
          "type": "string"
        },
        "callout": {
          "$ref": "#/$defs/callout"
        }
      }
    },
    "carType": {
      "description": "Side-view silhouette only. Planning length is the general car length (60 ft) unless a car sets its own.",
      "enum": [
        "generic",
        "boxcar_50",
        "boxcar_60",
        "covered_hopper_small",
        "covered_hopper_large",
        "covered_hopper_plastics",
        "open_hopper",
        "gondola",
        "tank_general",
        "tank_pressure",
        "flat_bulkhead",
        "flat_centerbeam",
        "flat_89",
        "autorack",
        "well_car",
        "reefer"
      ]
    },
    "locoType": {
      "enum": [
        "six_axle",
        "four_axle",
        "switcher"
      ]
    },
    "loco": {
      "description": "One loco, when specific locos matter.",
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "$ref": "#/$defs/locoType"
        },
        "lengthFt": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "car": {
      "description": "One car, when specific cars matter.",
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "$ref": "#/$defs/carType"
        },
        "lengthFt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "state": {
          "enum": [
            "loaded",
            "empty"
          ]
        },
        "mark": {
          "description": "Reporting mark, e.g. ABCX.",
          "type": "string"
        },
        "number": {
          "description": "Car number, e.g. 1234.",
          "type": "string"
        },
        "spot": {
          "description": "Numbered spot at a facility.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "stop": {
      "description": "Exactly where a move ends, in railway terms.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "track",
            "ft",
            "end"
          ],
          "additionalProperties": false,
          "properties": {
            "track": {
              "$ref": "#/$defs/id"
            },
            "ft": {
              "type": "number"
            },
            "end": {
              "enum": [
                "lead",
                "rear"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "beyond",
            "ft",
            "end"
          ],
          "additionalProperties": false,
          "properties": {
            "beyond": {
              "description": "Switch id.",
              "$ref": "#/$defs/id"
            },
            "ft": {
              "type": "number",
              "minimum": 0
            },
            "end": {
              "enum": [
                "lead",
                "rear"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "offstage"
          ],
          "additionalProperties": false,
          "properties": {
            "offstage": {
              "description": "Which end of the main the equipment leaves by. Named by the main's logical boundary, never by a screen side, so mirroring the drawing cannot change the meaning.",
              "enum": [
                "arrival_end",
                "far_end"
              ]
            }
          }
        }
      ]
    }
  }
}
